<!DOCTYPE html>
<html>
<head>
  <%- include('./partials/links') %>
  <title>Review</title>
</head>
<body>
  <%- include('./partials/nav') %>
  <%- include('./partials/tips') %>
  <%- include('./partials/action') %>
  <div class="mx-2 text-center d-flex flex-column align-items-center">
    <% if (!user) { %>
      <h1>Please log in to your account !</h1>
      <a class="" href="/login">
        <i class="bi bi-box-arrow-in-right btn btn-success">Login</i>
      </a>
    <% } else { %>
      <h1 class="text-center text-info-dark pt-2"> Review ! </h1>
      <% if (tenQuizzes && tenQuizzes.length > 0  ) { %>
        <div 
          class="card ft-roboto fst-italic m-0 bg-secondary-dark showtopslow p-2 my-2"
        >
          <p class="fs-4 fw-bold text-info m-0 p-0">
            Last tests
          </p>
            <p class="fs-4 fw-bold text-info m-0 p-0">
              Average : 
            <span class="fw-light text-info-light ">
              <%= average %> / 6
            </span>
          </p>
        </div>
        <div class="card mb-4 shadow rounded-3 col-10">
          <div class="card-header bg-secondary-dark text-center rounded-top-3 m-0 p-0">
            <p class="fs-3 fw-bold text-info m-0 p-0">
              Test
            </p>
          </div>
          <!-- card -->
          <div class="card pt-0 px-4 rounded-0">
            <div class="row text-capitalize">
              <% if (showQuiz) { %>
                <div class="d-flex align-items-center justify-content-between fs-2 flex-sm-row">
                  <!-- btn left -->
                  <div class="showleft ms-3">
                    <% if (skip > 0) { %> 
                      <a 
                        href="/review?prev=true&skip=<%= skip %>" 
                        class="text-decoration-none text-info-dark"
                      >
                        <i class="bi bi-chevron-left fs-1 ms-2 ms-2"></i>
                      </a>
                    <% } else { %>
                      <i class="bi bi-chevron-left text-secondary-light fs-1 ms-2"></i>
                    <% } %>
                  </div>
                  <div>
                    <!-- scores -->
                    <div class="<%= color %>-dark fw-light">
                      Scores :
                      <span class="">
                        <%= showQuiz.score %> / 6
                      </span>
                    </div>
                    <!-- prise -->
                    <div>
                      <p class="fs-2 fst-italic fw-bold <%= color %>">
                        <%= prize %>
                      </p>
                    </div>
                  </div>
                  <!-- btn right -->
                  <div class="showright me-4">
                    <% if (skip < totalQuizzes - 1) { %>
                      <a 
                        href="/review?next=true&skip=<%= skip %>" 
                        class="text-decoration-none text-info-dark"
                      >
                        <i class="bi bi-chevron-right fs-1"></i>
                      </a>
                    <% } else { %>
                      <i class="bi bi-chevron-right text-secondary-light fs-1"></i>
                    <% } %>
                  </div>
                </div>
              <% } %>
              <% if (showQuiz && showQuiz.data) {%>
                <% showQuiz.data.forEach(data => { %>
                  <div class="col-sm-4 mb-3 px-1">
                    <div class="card rounded shadow showtopslow" onmouseenter="handleMouseEnter(event)">
                      <div 
                        class="card-header fw-bol text-white rounded-top text-capitalize <%= data[2] ? 'bg-danger-dark' : 'bg-success' %>"
                      >
                      <%= data[0] %>
                    </div>
                    <div class="card-body rounded-0">
                      <p class="card-text text-capitalize">
                        <%= data[1] %> <% if(!data[2]) { %> 
                          <i class="bi bi-check-circle-fill text-success"></i>
                        <% } %>
                        </p>
                        <% if (data[2]) { %>
                          <p class="card-text text-danger text-capitalize">
                            <%= data[2] %> <i class="bi bi-x-circle-fill"></i>
                          </p>
                        <% } %>
                      </div>
                    </div>
                  </div>
                <% }) %>
              <% } %>
            </div>
          </div>
          <div class="card-footer bg-secondary-dark rounded-bottom-3">
            <% if (showQuiz) { %>
              <div class="d-flex flex-column flex-sm-row">
                <div class="col fw-bold text-info showleft">
                  Scores : 
                  <span class="text-info-light text-capitalize">
                    <%= showQuiz.score %> / 6  
                  </span>
                </div>
                <div class="col fw-bold text-info showleft">
                  lesson : 
                  <span class="text-info-light text-capitalize">
                    <%= showQuiz.lessonName %>
                  </span>
                </div>
                <div class="col fw-bold text-info showleft">
                  Category : 
                  <span class="text-info-light text-capitalize text-low">
                    <%= showQuiz.categoryName %>
                  </span>
                </div>
              </div>
            <% } %>
          </div>
        </div>
        
      <% } else { %>
        <div class="alert alert-warning" role="alert">
          No test data found.
        </div>
      <% } %>
      <% if (tenQuizzes && tenQuizzes.length > 0) { %>
        <div class="col-10 mb-5">
          <table class="table table-bordered shadow table-striped table-sm">
            <thead>
              <tr>
                <th scope="col"><span class="showtopspeed">ID</span></th>
                <th scope="col"><span class="showtopspeed">Lesson</span></th>
                <th scope="col"><span class="showtopspeed">Category</span></th>
                <th scope="col"><span class="showtopspeed">Score</span></th>
              </tr>
            </thead>
            <tbody>
              <% tenQuizzes.forEach((quiz, index) => { %>
                <tr>
                  <th scope="row"><span class="showtopspeed"><%= index + 1 %></span></th>
                  <td><span class="showtopspeed"><%= quiz.lessonName %></span></td>
                  <td><span class="showtopspeed"><%= quiz.categoryName %></span></td>
                  <td><span class="showtopspeed"><%= quiz.score %></span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>   
        </div>
      <% } %>
    <% } %>
  </div>
  <%- include('./partials/footer') %>
  
</body>
</html>
