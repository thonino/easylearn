<% if (user) { %>
  <nav class="bg-white p-2 text-center ">
      <!-- Groupe 1-->
    <div class="btn-group" role="group" aria-label="Navigation - Pages">
      <% if (selectedLesson && notesFull.length > 0) { %>
      <a 
        href="/notes" 
        class="btn btn-primary btn-sm fw-bold text-light shadow <%= currentPath === '/notes' ? 'active' : '' %>"
      >
        <i class="bi bi-book-fill d-sm-inline d-none" ></i> Learn 
      </a>
      <% } else { %>
      <span class="btn btn-sm bg-secondary-light text-secondary cursor-default">
        <i class="bi bi-book-fill d-sm-inline d-none"></i> Learn 
      </span>
      <% } %>
      <% if (notesFull && notesFull.length > 5) { %>
      <a 
        href="/test" 
        class="btn btn-primary btn-sm fw-bold text-light shadow <%= currentPath === '/test' ? 'active' : '' %>"
      >
        <i class="bi bi-controller d-sm-inline d-none"></i> Test 
      </a>
      <% } else { %>
      <span class="btn btn-sm bg-secondary-light text-secondary cursor-default">
        <i class="bi bi-controller d-sm-inline d-none"></i> Test 
      </span>
      <% } %>
      <% if (tenQuizzes && tenQuizzes.length > 0) { %>
      <a 
        href="/review" 
        class="btn btn-primary btn-sm fw-bold text-light shadow <%= currentPath === '/review' ? 'active' : '' %>"
      >
        <i class="bi bi-file-earmark-check d-sm-inline d-none"></i> Review 
      </a>
      <% } else { %>
      <span class="btn btn-sm bg-secondary-light text-secondary cursor-default">
        <i class="bi bi-file-earmark-check d-sm-inline d-none"></i>  Review
      </span>
      <% } %>
    </div>
    <!-- Groupe 2-->
    <div class="btn-group " role="group" aria-label="Navigation - Modals">
      <button class="btn btn-success btn-sm fw-bold text-light shadow" data-bs-toggle="modal" data-bs-target="#lessonModal">
        <i class="bi bi-plus-lg"></i> Lesson
      </button>
      <% if (user && lessons && selectedLesson) { %>
      <button class="btn btn-success btn-sm fw-bold text-light shadow" data-bs-toggle="modal" data-bs-target="#noteModal">
        <i class="bi bi-plus-lg"></i> Note
      </button>
      <% } else { %>
      <span class="btn btn-sm bg-secondary-light text-secondary  cursor-default">
        <i class="bi bi-pencil-fill"></i> Note
      </span>
      <% } %>
    </div>
  </nav>
  
  
  
<% } %>  
<% if (user ) { %>
  <!-- Lesson Modal -->
    <div class="modal fade" id="lessonModal" tabindex="-1">
      <div class="modal-dialog">
        <div class="modal-content p-0 m-0">
          <i class="bi bi-plus-lg text-center text-info-dark fs-1"></i>
          <div class="modal-header text-info-dark  fs-4 p-0 ms-3">
            <p class="modal-title ">New Lesson</p>
            <button 
              class="btn-close me-2 showright" 
              type="button" 
              data-bs-dismiss="modal" 
              aria-label="Close">
            </button>
          </div>
          <div class="modal-body">
            <form class="" action="/addlesson" method="POST">
              <div class="mb-3">
                <label 
                  for="Lessonname" 
                  class="form-label text-info-dark fst-italic fw-bold m-0 p-0 mb-1"
                >
                  Lesson Name
                </label>
                <input type="text" class="form-control" name="lessonName" placeholder="write the lesson name..">
                <% if (user._id) { %>
                  <input type="hidden" name="userId" value="<%= user._id %>">
                  <% } %>
              </div>
              <button type="submit" class="btn bg-info-dark text-light">
                Add
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  <!-- Modal New Note-->
  <div class="modal fade" id="noteModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <i class="bi bi-plus-lg text-center text-success-dark fs-1"></i>
        <div class="modal-header text-success-dark fs-4 p-0 ms-3">
          <p class="modal-title ">New Note</p>
          <button 
            class="btn-close me-2" 
            type="button" 
            data-bs-dismiss="modal" 
            aria-label="Close">
          </button>
        </div>
        <div class="modal-body">
          <form action="/addnote" method="POST">
            <div class="mb-3">
              <label 
                for="back" 
                class="form-label text-info fst-italic fw-bold m-0 p-0 mb-1"
              >
                Face A
              </label>
              <input type="text" class="form-control" name="back" placeholder="write face a...">
            </div>
            <div class="mb-3">
              <label 
                for="front" 
                class="form-label text-success fst-italic fw-bold m-0 p-0 mb-1"
              >
                Face B
              </label>
              <input type="text" class="form-control" name="front" placeholder="write face b...">
            </div>
            <div class="mb-3">
              <label 
                for="example" 
                class="form-label text-warning fst-italic fw-bold m-0 p-0 mb-1"
              >
                Example
              </label>
              <input type="text" class="form-control" name="example" placeholder="give an example...">
            </div>
            <% if (categories) { %>
              <select 
                name="selectedCategory" 
                class="form-select text-capitalize bg-success-light mt-2"
                onchange="hideContainer(this)"
              >
                <option value="uncategorized" hidden>uncategorized</option>
                <option value="newCat">new category</option>
                <% categories.forEach(category=> { %>
                  <option value="<%= category.categoryName %>">
                    <%= category.categoryName %>
                  </option>
                  <% }) %>
              </select>
            <% } %>
            <div id="categoryContainer" style="display: none;">
              <label for="newCategory" class="form-label ms-1 mt-1 fw-bold text-2">
                Create a new category
              </label>
              <input 
                type="text" 
                class="form-control" 
                name="newCategory" 
                placeholder="write the category name..."
              >
            </div>
            <% if (selectedLesson) { %>
              <input type="hidden" name="lessonName" value="<%= selectedLesson %>">
            <% } %>
            <input type="hidden" name="userId" value="<%= user._id %>">
            <button type="submit" class="btn bg-success-dark text-light mt-2">
              Add
            </button>
            <button 
              type="submit" 
              name="action" 
              value="addMore"
              class="btn bg-success-dark text-light mt-2"
            >
              Add More
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
<% } %>
<script>
  // Vérifier si le paramètre modal=open est dans l'URL
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('modal') === 'open') { 
    var noteModal = new bootstrap.Modal(document.getElementById('noteModal'));
    noteModal.show();
  }
</script>


