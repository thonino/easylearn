<nav class="navbar navbar-expand-sm navbar-dark bg-dark gap-2 m-0 px-1 pe-2 py-1">
  <a class="navbar-brand fs-6 fw-bold text-info m-0 p-0" href="/">
    <img  src="/img/logo.png" width="30px" class="m-0 p-0">
    EasyLearn
  </a>
  <% if (lessons && lessons.length> 0) { %>
    <form id="lessonForm" action="/selectLesson" method="POST" style="margin-top:-2px !important;">
      <select 
        id="lessonSelect" 
        name="lesson" 
        class="form-select form-design ft-roboto text-capitalize fw-light bg-dark text-info rounded m-0 p-0 px-2 "
      >
        <option hidden>
          <% if (selectedLesson) { %><br>
            <p class="text-secondary text-center text-capitalize ms-sm-3  m-3">
              <%= selectedLesson %>
            </p>
          <% } else { %>
          Select 
          <% } %>
        </option>
          <% lessons.forEach(lesson=> { %>
            <option value="<%= lesson.lessonName %>">
              <%= lesson.lessonName %>
            </option>
          <% }) %>
      </select>
    </form>
  <% }  %>
  <button class="navbar-toggler bg-secondary-dark m-0 p-0 px-1 my-1" type="button" data-bs-toggle="collapse"
    data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
    <span class="navbar-toggler-icon"></span>
  </button>
  <div id="navbarNav" class="collapse navbar-collapse"> 
    <% if (!user) { %>
      <ul 
        class="ms-sm-auto d-flex align-items-center gap-2 p-0 m-0 ms-2 mb-1 mb-sm-0"
        style="margin-top:-2px !important;" 
      >
        <a href="/register" class="badge bg-info text-dark text-decoration-none">
          Sign-up 
          <!-- <i class="bi bi-box-arrow-in-right"> </i> -->
        </a>
        <a href="/login" class="badge bg-info text-dark text-decoration-none">
          Login 
          <!-- <i class="bi bi-box-arrow-in-right"></i> -->
        </a>
        <% if (tips && tips==="d-none" ) { %>
          <form action="/tips" method="post">
            <input type="hidden" name="status"/>
            <button type="submit" class="badge bg-dark text-warning">
              Tips
            </button>
          </form>
          <% } %>
      </ul>
    <% } else { %>
      <ul 
        class="ms-sm-auto d-flex align-items-center gap-2 p-0 m-0 ms-2 mb-sm-0" 
        style="margin-top:-2px !important;"
      >
        <% if (!user) { %>
          <a href="/register" class="badge bg-info text-dark text-decoration-none">Sign-up</a>
          <a href="/login" class="badge bg-info text-dark text-decoration-none">Login</a>
        <% } else { %>
          <a href="/account" class="badge bg-info text-dark text-decoration-none">Account</a>
          <a href="/logout" class="badge bg-danger text-light text-decoration-none">Logout</a>
        <% } %>
        <% if (tips && tips==="d-none") { %>
          <form action="/tips" method="post" class="d-inline-block">
            <input type="hidden" name="status"/>
            <button type="submit" class="badge bg-dark text-warning px-2">Tips</button>
          </form>
        <% } %>
      </ul>
      
    <% } %>
  </div> 
</nav>