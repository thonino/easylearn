<!DOCTYPE html>
<html>
<head>
  <%- include('./partials/links') %>
  <title>EasyLearn</title>
</head>
  <body>
    <%- include('./partials/nav') %>
    <%- include('./partials/tips') %>
    <%- include('./partials/action') %>
    <div class="row-6 d-flex flex-column align-items-center mb-3">
      <div class="vw-100  bg-white wrapper py-3 m-0 p-0">
        <h1 class="fw-bold text-info text-center ">EasyLearn</h1>
        <div class="d-flex justify-content-center">
          <!-- First element -->
          <div class="container d-flex justify-content-center flex-column col-8">
            <h2 class="fs-2 fw-light fst-italic text-center text-info-dark mb-3 showright">
              Learn and test yourself
            </h2>
            <div class="d-flex justify-content-center align-items-center">
              <div class="d-flex justify-content-center ">
                <img src="/img/design1.png" 
                  class="img-fluid w-100" 
                  onmouseenter="handleMouseEnter(event)"
                >
              </div>
              <div class="d-flex flex-wrap justify-content-center me-1 col-6">
                <img 
                  src="/img/face1.png" class="img-fluid w-50 h-50" 
                  onmouseenter="handleMouseEnter(event)"
                >
                <img 
                  src="/img/face2.png" class="img-fluid w-50 h-50" 
                  onmouseenter="handleMouseEnter(event)"
                >
                <img 
                  src="/img/example.png" class="img-fluid w-50 h-50" 
                  onmouseenter="handleMouseEnter(event)"
                >
              </div>
            </div>
            </div>
          </div>
        <!-- Second element  -->
        <div id="accordionExample" class="accordion container my-3 col-8">
          <div class="accordion-item shadow">
            <h2 class="accordion-header">
              <button 
                class="accordion-button" 
                type="button" 
                data-bs-toggle="collapse" 
                data-bs-target="#collapseOne" 
                aria-expanded="true" 
                aria-controls="collapseOne"
              >
                <span class="fs-2 fw-light text-info-dark text-center w-100">About</span>
              </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#accordionExample">
              <p class="accordion-body fs-4 fst-italic text-center text-info-dark">
                It's an app for anyone who wants to learn words or definitions by heart. 
                Very easy to use and completely free.                
              </p>
            </div>
          </div>
          <div class="accordion-item shadow">
            <h2 class="accordion-header">
              <button 
                class="accordion-button collapsed" 
                type="button" 
                data-bs-toggle="collapse" 
                data-bs-target="#collapseTwo" 
                aria-expanded="false" 
                aria-controls="collapseTwo"
              >
                <span class="fs-2 fw-light text-info-dark text-center w-100">Simply</span>
              </button>
            </h2>
            <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
              <p class="accordion-body fs-4 fst-italic text-center text-info-dark">
                Create a lesson, add notes, after 6 notes added start yours test. 
                Let yourself be guided by the fantastic Tips feature.
              </p>
            </div>
          </div>
          <div class="accordion-item shadow">
            <h2 class="accordion-header">
              <button 
                class="accordion-button collapsed" 
                type="button" 
                data-bs-toggle="collapse" 
                data-bs-target="#collapseThree" 
                aria-expanded="false" 
                aria-controls="collapseThree"
              >
                <span class="fs-2 fw-light text-info-dark text-center w-100 text-center">Free App</span>
              </button>
            </h2>
            <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
              <p class="accordion-body fs-4 fst-italic text-center text-info-dark">
                Create an account Sign in Let yourself be guided!
              </p>
            </div>
          </div>
        </div>
        <!-- who -->
        <h2 class="fs-2 fw-light fst-italic text-center text-info-dark my-3 showright">
          Who needs the app ?
        </h2>
        <div class="container d-flex justify-content-center">
          <%- include('./partials/carousel') %>
        </div>
      </div>
    </div>
    <%- include('./partials/footer') %>
    <script>
        document.getElementById('btn-about').addEventListener('click', function () { showContent('about');});
        document.getElementById('btn-simply').addEventListener('click', function () { showContent('simply');});
        document.getElementById('btn-free').addEventListener('click', function () { showContent('free'); });
        function showContent(id) {
          document.querySelectorAll('.content').forEach(function (content){ content.classList.add('hidden');});
          document.getElementById(id).classList.remove('hidden');
        }
    </script>
    <script src="/script.js"></script>
  </body>
</html>
